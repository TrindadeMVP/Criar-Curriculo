{
  "name": "gerador-curriculos-app",
  "version": "1.3.2",
  "private": true,
  "description": "Gerador de Currículos para Windows e Android",
  "main": "electron/main.cjs",
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "check": "node --check electron/main.cjs && node --check scripts/prepare-assets.mjs && node --check scripts/import-ibge.mjs && node --check scripts/import-cbo.mjs && node --check scripts/verify-artifacts.mjs && node --check scripts/android-version.mjs && node scripts/check-html.mjs",
    "test:unit": "node --test \"tests/*.test.mjs\"",
    "test:e2e": "python3 tests/e2e.py",
    "build:windows": "electron-builder --win nsis --x64 --publish never",
    "verify:windows": "node scripts/verify-artifacts.mjs windows",
    "android:init": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:debug": "npm run android:sync && node scripts/android-version.mjs && cd android && ./gradlew assembleDebug",
    "verify:android": "node scripts/verify-artifacts.mjs android",
    "build:portable": "node scripts/build-portable.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "jspdf": "2.5.1"
  },
  "build": {
    "appId": "com.geradorcurriculos.desktop",
    "productName": "Gerador de Currículos",
    "directories": {
      "output": "dist-windows"
    },
    "files": [
      "web/**/*",
      "electron/**/*",
      "package.json",
      "!web/**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Gerador-Curriculos-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Gerador de Currículos",
      "language": "1046",
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Gerador-Curriculos-Setup-${version}.${ext}"
    }
  }
}
